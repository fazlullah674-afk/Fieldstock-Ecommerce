PORT=5001
NODE_ENV=development

# --- JWT ---
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Database ---
# Use "mssql" for production against SQL Server, or "sqlite" for quick local
# testing with no database server installed (see README).
DB_DIALECT=mssql
DB_HOST=localhost
DB_PORT=1433
DB_NAME=fieldstock
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Only used when DB_DIALECT=sqlite
DB_STORAGE=./dev.sqlite

# --- CORS ---
CLIENT_ORIGIN=http://localhost:5173
